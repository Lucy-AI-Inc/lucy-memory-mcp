# Public/non-secret project configuration
HOSTED_MCP_ENABLED=false
HOSTED_MCP_CANONICAL_URL=https://mcp.trylucy.ai/mcp
HOSTED_MCP_PRODUCT_BASE_URL=https://PRODUCT-STAGING.example
HOSTED_MCP_OAUTH_ISSUER=https://SELECTED-PROVIDER.example/
HOSTED_MCP_OAUTH_JWKS_URL=https://SELECTED-PROVIDER.example/.well-known/jwks.json
HOSTED_MCP_OAUTH_INTROSPECTION_URL=https://SELECTED-PROVIDER.example/oauth/introspect
HOSTED_MCP_ALLOWED_ORIGINS=https://APPROVED-PRIVATE-BETA-CLIENT.example
HOSTED_MCP_AUTH_MODE=oauth
HOSTED_MCP_CALL_TIMEOUT_MS=55000

# Secret values: install in Vercel; placeholders are deliberately nonfunctional
HOSTED_MCP_PRODUCT_SERVICE_CREDENTIAL=[REDACTED_32+_BYTE_MCP_SERVICE_CREDENTIAL]
HOSTED_MCP_OAUTH_INTROSPECTION_AUTHORIZATION=[REDACTED_FULL_AUTHORIZATION_HEADER_VALUE]
HOSTED_MCP_LOG_HASH_KEY=[REDACTED_DISTINCT_32+_BYTE_LOG_HMAC_KEY]

# Staging-static escape hatch (preview/development only; omit in OAuth deployments)
# HOSTED_MCP_STAGING_STATIC_BEARER=[REDACTED_STAGING_ONLY_BEARER]
# HOSTED_MCP_STAGING_STATIC_SUBJECT=11111111-1111-1111-1111-111111111111
# HOSTED_MCP_STAGING_STATIC_WORKSPACE_ID=22222222-2222-2222-2222-222222222222
# HOSTED_MCP_STAGING_STATIC_SCOPES=memory:read,memory:propose

# Local harness only. Omit from every Vercel environment.
# HOSTED_MCP_ALLOW_INSECURE_LOOPBACK=false
